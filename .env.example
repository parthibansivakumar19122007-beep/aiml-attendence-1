# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production

# Database Engine Selection (Set USE_SQLITE=1 for instant local zero-dependency database)
USE_SQLITE=1

# MySQL Database Configuration (Used when USE_SQLITE=0 and MySQL server is running)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aiml_attendance_db

# Security & Geofence (meters)
GEOFENCE_RADIUS_M=50.0
TIMEZONE=Asia/Kolkata
